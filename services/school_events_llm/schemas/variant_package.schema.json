{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Assignment": {
      "properties": {
        "role_id": {
          "type": "string"
        },
        "participant_type": {
          "const": "parent",
          "default": "parent",
          "type": "string"
        },
        "role_mode": {
          "enum": [
            "helper",
            "active_participant",
            "audience",
            "evaluator"
          ],
          "type": "string"
        },
        "count": {
          "minimum": 1,
          "type": "integer"
        },
        "block_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "role_id",
        "role_mode",
        "count",
        "block_ids"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "Block": {
      "properties": {
        "block_id": {
          "pattern": "^block_\\d{2}$",
          "type": "string"
        },
        "start_minute": {
          "minimum": 0,
          "type": "integer"
        },
        "duration_minutes": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "teacher_script": {
          "minLength": 20,
          "type": "string"
        },
        "pupil_actions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "role_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "material_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "block_id",
        "start_minute",
        "duration_minutes",
        "title",
        "purpose",
        "teacher_script",
        "pupil_actions",
        "role_ids"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "Concept": {
      "properties": {
        "summary": {
          "minLength": 10,
          "type": "string"
        },
        "goal": {
          "minLength": 5,
          "type": "string"
        },
        "tasks": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "expected_outcomes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "values_to_mechanics": {
          "items": {
            "$ref": "#/$defs/ValueMechanic"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "summary",
        "goal",
        "tasks",
        "expected_outcomes",
        "values_to_mechanics"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "FactClaim": {
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fragment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "needs_teacher_check": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "claim_id",
        "text",
        "location"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "Material": {
      "properties": {
        "material_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "type": {
          "enum": [
            "teacher_instruction",
            "worksheet",
            "activity_card",
            "slide_outline",
            "quiz",
            "discussion_questions",
            "handout",
            "props_checklist",
            "parent_instruction",
            "audience_ballot",
            "jury_scorecard",
            "award_instruction"
          ],
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "used_in_blocks": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "audience": {
          "enum": [
            "teacher",
            "pupil",
            "pupils_group",
            "parent",
            "all"
          ],
          "type": "string"
        },
        "content": {
          "minLength": 20,
          "type": "string"
        },
        "teacher_notes": {
          "type": "string"
        },
        "print_required": {
          "type": "boolean"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "estimated_preparation_minutes": {
          "maximum": 240,
          "minimum": 0,
          "type": "integer"
        },
        "family_task": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "material_id",
        "type",
        "title",
        "used_in_blocks",
        "audience",
        "content",
        "teacher_notes",
        "print_required",
        "estimated_preparation_minutes"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "ParentParticipationPlan": {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parents_count": {
          "minimum": 0,
          "type": "integer"
        },
        "parent_size_group": {
          "enum": [
            "none",
            "1-2",
            "3-5",
            "6-10",
            "11_plus"
          ],
          "type": "string"
        },
        "selected_roles": {
          "items": {
            "enum": [
              "helper",
              "active_participant",
              "audience",
              "evaluator"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "audience_engagement": {
          "enum": [
            "none",
            "feedback",
            "vote",
            "audience_award"
          ],
          "type": "string"
        },
        "assignments": {
          "items": {
            "$ref": "#/$defs/Assignment"
          },
          "type": "array"
        },
        "voting": {
          "anyOf": [
            {
              "$ref": "#/$defs/Voting"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "teacher_fallback": {
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "parents_count",
        "parent_size_group",
        "audience_engagement",
        "teacher_fallback"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "PupilGrouping": {
      "properties": {
        "total_pupils": {
          "minimum": 1,
          "type": "integer"
        },
        "mode": {
          "enum": [
            "whole_class",
            "pairs",
            "small_groups",
            "mixed"
          ],
          "type": "string"
        },
        "group_sizes": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "type": "array"
        },
        "block_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "total_pupils",
        "mode",
        "group_sizes"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "Role": {
      "properties": {
        "role_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "participant_type": {
          "enum": [
            "teacher",
            "pupil",
            "pupils_group",
            "parent",
            "guest"
          ],
          "type": "string"
        },
        "role_mode": {
          "anyOf": [
            {
              "enum": [
                "helper",
                "active_participant",
                "audience",
                "evaluator"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "type": "string"
        },
        "count": {
          "minimum": 1,
          "type": "integer"
        },
        "block_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "role_id",
        "participant_type",
        "title",
        "count"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "Source": {
      "properties": {
        "source_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "title",
        "publisher",
        "url"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "ValueMechanic": {
      "properties": {
        "value_id": {
          "enum": [
            "family",
            "mutual_aid",
            "historical_memory",
            "labour_creation",
            "cultural_diversity",
            "citizenship"
          ],
          "type": "string"
        },
        "mechanic_type": {
          "enum": [
            "family_research",
            "team_task",
            "source_work",
            "joint_product",
            "culture_comparison",
            "real_problem_solving",
            "class_collective_task",
            "pair_task",
            "discussion"
          ],
          "type": "string"
        },
        "mechanic": {
          "minLength": 10,
          "type": "string"
        },
        "block_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "value_id",
        "mechanic_type",
        "mechanic"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "VariantBody": {
      "properties": {
        "variant_id": {
          "pattern": "^v[1-3]$",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "concept": {
          "$ref": "#/$defs/Concept"
        },
        "pupil_grouping": {
          "$ref": "#/$defs/PupilGrouping"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/Role"
          },
          "minItems": 2,
          "type": "array"
        },
        "timeline": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "minItems": 2,
          "type": "array"
        },
        "materials": {
          "items": {
            "$ref": "#/$defs/Material"
          },
          "type": "array"
        },
        "parent_participation_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParentParticipationPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "teacher_instructions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "fact_claims": {
          "items": {
            "$ref": "#/$defs/FactClaim"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "variant_id",
        "title",
        "concept",
        "pupil_grouping",
        "roles",
        "timeline",
        "teacher_instructions"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "Voting": {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "award_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "voters_count_planned": {
          "minimum": 0,
          "type": "integer"
        },
        "criterion": {
          "type": "string"
        },
        "method": {
          "default": "paper_ballot",
          "type": "string"
        },
        "votes_per_person": {
          "default": 1,
          "minimum": 1,
          "type": "integer"
        },
        "tie_rule": {
          "type": "string"
        },
        "block_id": {
          "type": "string"
        },
        "material_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "enabled",
        "voters_count_planned",
        "criterion",
        "tie_rule",
        "block_id"
      ],
      "type": "object",
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.2",
      "type": "string"
    },
    "task": {
      "const": "variant_package",
      "default": "variant_package",
      "type": "string"
    },
    "variant": {
      "$ref": "#/$defs/VariantBody"
    }
  },
  "required": [
    "variant"
  ],
  "type": "object",
  "additionalProperties": false
}