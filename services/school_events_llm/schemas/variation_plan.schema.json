{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ConceptPlan": {
      "properties": {
        "variant_id": {
          "pattern": "^v[1-3]$",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "narrative_approach": {
          "type": "string"
        },
        "primary_mechanic": {
          "enum": [
            "collaborative_planning",
            "team_game",
            "quest_route",
            "mini_project",
            "source_research",
            "creative_workshop",
            "performance",
            "discussion_club",
            "quiz_competition",
            "interview_research"
          ],
          "type": "string"
        },
        "engagement_mode": {
          "enum": [
            "whole_class",
            "pairs",
            "small_groups",
            "mixed"
          ],
          "type": "string"
        },
        "planned_structure": {
          "items": {
            "$ref": "#/$defs/PlannedBlockStub"
          },
          "minItems": 2,
          "type": "array"
        },
        "key_activities": {
          "items": {
            "$ref": "#/$defs/KeyActivity"
          },
          "minItems": 1,
          "type": "array"
        },
        "distinctive_result": {
          "type": "string"
        },
        "differs_from": {
          "items": {
            "$ref": "#/$defs/Difference"
          },
          "type": "array"
        },
        "values_to_mechanics": {
          "items": {
            "$ref": "#/$defs/ConceptValuePreview"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "variant_id",
        "title",
        "summary",
        "narrative_approach",
        "primary_mechanic",
        "engagement_mode",
        "planned_structure",
        "key_activities",
        "distinctive_result",
        "values_to_mechanics"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "ConceptValuePreview": {
      "properties": {
        "value_id": {
          "enum": [
            "family",
            "mutual_aid",
            "historical_memory",
            "labour_creation",
            "cultural_diversity",
            "citizenship"
          ],
          "type": "string"
        },
        "mechanic_type": {
          "enum": [
            "family_research",
            "team_task",
            "source_work",
            "joint_product",
            "culture_comparison",
            "real_problem_solving",
            "class_collective_task",
            "pair_task",
            "discussion"
          ],
          "type": "string"
        },
        "mechanic": {
          "type": "string"
        }
      },
      "required": [
        "value_id",
        "mechanic_type",
        "mechanic"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "Difference": {
      "properties": {
        "variant_id": {
          "type": "string"
        },
        "difference": {
          "type": "string"
        }
      },
      "required": [
        "variant_id",
        "difference"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "KeyActivity": {
      "properties": {
        "activity_type": {
          "enum": [
            "discussion",
            "team_task",
            "pair_task",
            "individual_task",
            "game",
            "quiz",
            "source_work",
            "creative_product",
            "performance",
            "project_pitch",
            "research",
            "reflection",
            "voting"
          ],
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "activity_type",
        "description"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "PlannedBlockStub": {
      "properties": {
        "order": {
          "minimum": 1,
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "activity_type": {
          "enum": [
            "discussion",
            "team_task",
            "pair_task",
            "individual_task",
            "game",
            "quiz",
            "source_work",
            "creative_product",
            "performance",
            "project_pitch",
            "research",
            "reflection",
            "voting"
          ],
          "type": "string"
        },
        "approx_minutes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "order",
        "title",
        "activity_type",
        "approx_minutes"
      ],
      "type": "object",
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.2",
      "type": "string"
    },
    "task": {
      "const": "variation_plan",
      "default": "variation_plan",
      "type": "string"
    },
    "concepts": {
      "items": {
        "$ref": "#/$defs/ConceptPlan"
      },
      "maxItems": 3,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "concepts"
  ],
  "type": "object",
  "additionalProperties": false
}