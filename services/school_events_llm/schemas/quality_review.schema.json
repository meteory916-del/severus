{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FactClaimReview": {
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "matches_fragment": {
          "type": "boolean"
        },
        "comment": {
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "matches_fragment",
        "comment"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "QualityFinding": {
      "properties": {
        "rule_code": {
          "type": "string"
        },
        "severity_suggested": {
          "enum": [
            "info",
            "warning",
            "critical"
          ],
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggested_action": {
          "type": "string"
        }
      },
      "required": [
        "rule_code",
        "severity_suggested",
        "location",
        "message",
        "suggested_action"
      ],
      "type": "object",
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.2",
      "type": "string"
    },
    "task": {
      "const": "quality_review",
      "default": "quality_review",
      "type": "string"
    },
    "variant_id": {
      "pattern": "^v[1-3]$",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/QualityFinding"
      },
      "type": "array"
    },
    "fact_claims_review": {
      "items": {
        "$ref": "#/$defs/FactClaimReview"
      },
      "type": "array"
    }
  },
  "required": [
    "variant_id"
  ],
  "type": "object",
  "additionalProperties": false
}