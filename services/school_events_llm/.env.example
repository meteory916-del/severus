# Выбор профиля модели из config/models.json
ACTIVE_MODEL=qwen_local_9b

# Доступы (в реальном .env значения секретные; .env не коммитить)
OPENAI_API_KEY=
GIGACHAT_AUTH_KEY=
QWEN_API_KEY=

APP_ENV=development
APP_LOG_LEVEL=INFO

# Трассы генераций (полные промпты и ответы - только локально)
DATA_DIR=./data
LOG_FULL_PROMPTS=true
LOG_FULL_RESPONSES=true

# Межпроцессная блокировка локальной модели - опция, если та же локальная модель
# используется не только этим сервисом. По умолчанию выключена; для включения: true.
# Все программы, которые делят модель, должны использовать один и тот же lock-файл.
LOCAL_LLM_MUTEX_ENABLED=false
LOCAL_LLM_MUTEX_PATH=./data/locks/lm_studio.lock
LOCAL_LLM_MUTEX_WAIT_SECONDS=120

# Общий каталог событий проекта (severus/catalog), путь относительно папки сервиса
CATALOG_DIR=../../catalog

REQUEST_DEFAULTS_FILE=./config/request_defaults.json
SCHOOL_PROFILE_FILE=./config/school_profile.json

PILOT_REGION_ID=RU-SVE
MAX_PUPILS_PILOT=35
MAX_VARIANTS=3

# Внутренний HTTP-сервис для основного Backend Severus
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8090
SERVICE_AUTH_TOKEN=

# DEV-проверка полной интеграции без реальной модели
LLM_SERVICE_FIXTURE_MODE=false
LLM_SERVICE_FIXTURES=

# OpenAI-compatible шлюз команды. URL и ключ задаются только через окружение.
LITELLM_BASE_URL=
LITELLM_API_KEY=