{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "title", "url"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string" },
          "url": { "type": "string" },
          "retrieved_at": { "type": "string" },
          "verification_status": { 
            "type": "string",
            "enum": [
              "draft",
              "pending",
              "verified",
              "rejected",
              "needs_content_review",
              "verified_minimum_met",
              "candidate_date_conflict_review",
              "verified_event_occurrence_date_conflict",
              "candidate_needs_direct_legal_check",
              "candidate_needs_article_level_check"
            ]
          },
          "topics": {
            "type": "array",
            "items": { "type": "string" }
          },
          "regions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "text_excerpt": { "type": "string" },
          "note": { "type": "string" },
          "content_relevance_checked": { "type": "boolean" },
          "url_access_checked_in_this_revision": { "type": "boolean" },
          "verified_by": { "type": "string" },
          "verified_at": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "fragments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "quote"],
        "properties": {
          "fragment_id": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "minLength": 1 },
          "quote": { "type": "string", "minLength": 1 },
          "verification_status": { 
            "type": "string",
            "enum": [
              "draft",
              "verified",
              "rejected",
              "needs_content_review",
              "verified_minimum_met",
              "candidate_date_conflict_review",
              "verified_event_occurrence_date_conflict",
              "candidate_needs_direct_legal_check",
              "candidate_needs_article_level_check"
            ]
          },
          "collected_by": { "type": "string" },
          "verified_by": { "type": "string" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "required_minimum": { "type": "integer", "minimum": 1 },
    "verified_count": { "type": "integer", "minimum": 0 },
    "status": { 
      "type": "string",
      "enum": ["complete", "incomplete", "verified_minimum_met"]
    },
    "note": { "type": "string" },
    "audit_note": { "type": "string" }
  },
  "additionalProperties": false
}
