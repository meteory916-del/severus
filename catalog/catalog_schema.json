{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/catalog_schema.json",
  "title": "School event catalog card (v2.6)",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "date_rule",
    "supported_age_groups",
    "supported_formats",
    "educational_goals",
    "age_appropriateness_notes",
    "source_collection",
    "source_ids",
    "review",
    "regional_variants",
    "catalog_version",
    "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["federal", "regional", "school", "cultural", "calendar"]
    },
    "date_rule": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "type": "string" },
        "value": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "supported_age_groups": { "type": "array", "items": { "type": "string" } },
    "supported_formats": { "type": "array", "items": { "type": "string" } },
    "educational_goals": { "type": "array", "items": { "type": "string" } },
    "values": { "type": "array", "items": { "type": "string" } },
    "age_appropriateness_notes": { "type": "object", "additionalProperties": { "type": "string" } },
    "source_collection": { "type": "string" },
    "source_ids": { "type": "array", "items": { "type": "string" } },
    "review": {
      "type": "object",
      "properties": {
        "historical_accuracy_required": { "type": "boolean" },
        "age_appropriateness_required": { "type": "boolean" },
        "cultural_review_required": { "type": "boolean" }
      }
    },
    "regional_variants": { "type": "array", "items": { "type": "string" } },
    "catalog_version": { "type": "string" },
    "updated_at": { "type": "string" },
    "regional_topics": { "type": "array", "items": { "type": "string" } },
    "facts_to_verify": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
